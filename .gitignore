# Godot 4+ specific ignores
.godot/
/android/

# Telemetry dumps & generated debug artifacts
Debug/
debug_log_*.txt

# Stale backups
*.old

# Export artifacts
builds/
exports/
*.pck
*.zip
# Godot's .NET export drops the managed assemblies beside the binary
data_*_windows_*/
# Interrupted Godot exports leave these next to the target executable
*~RF*.TMP

# IDE / OS noise
.vs/
.idea/
*.user
Thumbs.db
.DS_Store
# Claude Code per-machine settings. The shared .claude/ contents (agents, commands) stay
# tracked; only the *.local.* files are machine-specific by convention.
.claude/settings.local.json

# Python bytecode and virtualenvs, anywhere - not just under rl/. The root-level analyze*.py
# scripts produce a __pycache__/ of their own, which the rl/-scoped patterns did not catch.
__pycache__/
*.py[cod]
.venv/

# RL exploration track (training artifacts)
rl/runs/
rl/*.onnx
rl/*.zip
# TensorBoard event files, wherever a stray --experiment_dir puts them
events.out.tfevents.*

# .NET build output (Godot keeps its own copy under .godot/mono)
obj/
bin/

# Note: Models/policy.onnx is deliberately NOT ignored. It is the one promoted policy
# used for in-engine playback, small (~55 KB), and worth versioning so a checkout can
# reproduce what the dummy does without a training run.

# Godot export output for RL training builds
build/

# AI temporary scripts
.working/


# Generated UID files from GDScript compilation
*.gdc.uid

# Archived training runs
rl/runs_archive/


# Isaac Lab track. dummy.urdf and dummy_rig.json ARE tracked: they are small, they are the
# generated rig contract that both engines read, and versioning them makes a scene change that
# alters the dummy visible in a diff. Everything below is a build artifact of those two.
isaac_lab/logs/
isaac_lab/outputs/
isaac_lab/assets/dummy.usd
isaac_lab/assets/configuration/
isaac_lab/assets/config.yaml
isaac_lab/assets/.asset_hash
# The exported .onnx files ARE tracked - they are the deliverable, ~950 KB each, and the whole
# point of the track. The TorchScript twins are not: same policy, re-derivable from the checkpoint
# with play.py --export_only, and they double the footprint for nothing.
isaac_lab/exported/*.pt

# --- Training artifacts -------------------------------------------------------
# Checkpoints and TensorBoard logs are REGENERATED OUTPUT, not source. They were tracked once and
# it put 2,272 *.pt files and 13 GB into the history, which is most of what `.git` weighs.
#
# The exported policy in Models/ stays tracked on purpose: it is the deliverable Godot loads, it is
# ~1 MB, and a scene that references a file nobody has is broken for everyone who clones.
isaac_lab_3/logs/
isaac_lab/logs/
rl/runs/
*.pt
*.tfevents.*

# Scratch and probes. Kept out because they are written to answer one question and are misleading
# once the answer is known - a stale reference_obs.json reads exactly like a current one.
isaac_lab_3/exported/
**/__pycache__/
*.pyc

# Root-level RSL-RL training output. `isaac_lab/logs/` and `isaac_lab_3/logs/` are already ignored
# above, but runs land in `logs/rsl_rl/` at the repo root, which those patterns do not reach: 8.3 GB
# across 64 runs, of which 189 files (env.yaml / agent.yaml / curriculum.json) are not covered by the
# `*.pt` rule and WOULD be committed. This is regenerated output - `restore()` reads it from disk
# locally, and the findings live in isaac_lab_3/SIM-TO-SIM.md - so none of it belongs in history.
# The note above records that checkpoints once put 13 GB into this repo; this is the same mistake by
# a different path.
logs/

# MuJoCo writes this next to the working directory on every model load.
MUJOCO_LOG.TXT

# Generated models and exported policies are rebuilt by build_mjcf.py / export_onnx.py. The two the
# scenes actually load are committed deliberately; sweep variants are not.
mujoco_rig/dummy_g*.xml
mujoco_rig/dummy_soft*.xml
mujoco_rig/*.onnx.data
