<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Required by addons/godot_rl_agents/onnx/csharp/ - the plugin's in-engine ONNX inference
         path used for the RL exploration track (see docs on RagdollRLBridge.cs). CPU execution
         provider is sufficient for a small MLP policy at inference time; GPU is only needed for
         training, which happens on the Python side. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
  </ItemGroup>
</Project>
